# LocalHire Backend - Environment Variables Template
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real secrets to version control.

# ── Server Configuration ──────────────────────────────────────
PORT=5000
NODE_ENV=development
# Public URL the browser uses for the frontend. Express serves the frontend on PORT, so this is
# normally http://localhost:5000. Email links and Google sign-in return the user to
# CLIENT_URL/pages/auth.html, which must be listed under Supabase -> Auth -> URL Configuration -> Redirect URLs.
CLIENT_URL=http://localhost:5000
# Public URL of this backend. Google sign-in returns to SERVER_PUBLIC_URL/api/auth/google/callback,
# which must also be listed in Supabase Redirect URLs.
SERVER_PUBLIC_URL=http://localhost:5000

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5500

# ── Authentication (JWT Secret) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# ── Hosted Supabase API Configuration (also the authentication provider) ──
# Supabase Auth sends the verification / password-reset emails and runs Google OAuth.
# All three keys are required for registration, verification, password reset and Google sign-in.
# Dashboard setup: see "Authentication setup" in README.md.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_secret_key

# ── Hosted Supabase PostgreSQL Database (Prisma) ──────────────
# Obtain in Supabase Dashboard → Connect → Connection string → URI
# Connection Pooler (port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432) for migrations:
DIRECT_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Razorpay Payment Gateway Configuration ────────────────────
# Obtain in Razorpay Dashboard → Settings → API Keys
# Public Key ID (rzp_test_... in test mode, rzp_live_... in production):
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
# Private Secret Key used for HMAC SHA256 payment signature verification:
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret_key
# Webhook secret configured in Razorpay Dashboard → Settings → Webhooks.
# Webhook URL: https://<your-domain>/api/payments/webhook   (the older /api/escrow/razorpay/webhook still works)
# Events to enable: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed
# (and, only if you use Route: transfer.processed, transfer.failed, product.route.activated, product.route.needs_clarification)
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# ── Pricing (fee, tax and cancellation fee default to 0; commission defaults to 10) ─────
# Platform fee added on top of the service price, paid by the customer (percent):
PLATFORM_FEE_PERCENT=0
# Tax (e.g. GST 18) charged on that platform fee, paid by the customer (percent of the fee):
PLATFORM_FEE_TAX_PERCENT=0
# Commission LocalHire deducts from the worker's service amount (percent). Standard rate: 10
WORKER_COMMISSION_PERCENT=10
# Share of the service amount a customer forfeits when cancelling after the worker is on the way (percent):
CUSTOMER_CANCELLATION_FEE_PERCENT=0

# ── Worker payouts ─────────────────────────────────────────────
# LEDGER_ONLY (default): earnings are recorded as OWED to the worker. No transfer is attempted or simulated, and
#                        nothing is ever shown as "paid". Use this unless Razorpay has enabled Route for you.
# ROUTE:                 payouts go through Razorpay Route linked accounts. Requires Route to be enabled by Razorpay;
#                        check with:  npm --prefix server run razorpay:route-check
PAYOUT_MODE=LEDGER_ONLY
# Business category sent when creating a worker's linked account (see Razorpay Route docs for allowed values):
ROUTE_BUSINESS_CATEGORY=services
ROUTE_BUSINESS_SUBCATEGORY=repair_and_cleaning

# ── Browser push notifications (Web Push) ─────────────────────
# Generate once with:  npm --prefix server run push:generate-keys
# Leave these empty to run without push: in-app and real-time notifications still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "mailto:you@example.com" or an https URL that identifies the sender to push services:
VAPID_SUBJECT=

# Time zone used to read workers' working hours when validating bookings (IANA name):
BUSINESS_TIMEZONE=Asia/Kolkata

# ── Seed Admin Credentials (Optional) ─────────────────────────
# Used when running `npm run prisma:seed` to provision an Admin user
ADMIN_EMAIL=admin@localhire.dev
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# ── Reviews (optional; these are the defaults) ─────────────────
# Review and report writes per signed-in account per 15 minutes, and public review reads per IP per minute.
# REVIEW_RATE_LIMIT_MAX=20
# REVIEW_READ_RATE_LIMIT_MAX=120

# ── Production hardening (see DEPLOYMENT.md) ───────────────────
# With NODE_ENV=production the server REFUSES TO START if a production-critical secret is missing, a placeholder or a
# development default. Use NODE_ENV=production on staging too.
# Number of reverse proxies / load balancers in front of the app (normally 1). Required behind a proxy so rate limits see real
# client IPs and HTTPS can be detected. Do not use "true".
# TRUST_PROXY=1
# Set to "false" only if your platform already redirects HTTP to HTTPS.
# FORCE_HTTPS=true
# `npm test` refuses a hosted Supabase DATABASE_URL (the tests write and delete rows). Set to "yes" ONLY for a dedicated
# throw-away staging project, never for production.
# ALLOW_TESTS_ON_HOSTED_DB=no

