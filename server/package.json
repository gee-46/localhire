{
  "name": "localhire-backend",
  "version": "1.0.0",
  "description": "Backend API server for LocalHire platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --require ./tests/helpers/safetyGuard.js --test --test-concurrency=1 \"tests/*.test.js\"",
    "dev": "nodemon server.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:check": "node scripts/check-db.js",
    "admin:promote": "node scripts/promote-admin.js",
    "auth:verify": "node scripts/verify-auth-setup.js",
    "storage:verify": "node scripts/verify-worker-storage.js",
    "razorpay:route-check": "node scripts/razorpay-route-check.js",
    "push:generate-keys": "node scripts/generate-vapid-keys.js",
    "auth:reset-legacy-preview": "node scripts/reset-legacy-email-verification.js",
    "auth:reset-legacy-apply": "node scripts/reset-legacy-email-verification.js --apply"
  },
  "keywords": [
    "localhire",
    "express",
    "socket.io",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4"
  }
}
